---
import KhumsGuide from "@/components/KhumsGuide";
import { getCampaign, getGivingOptions, getSiteSettings } from "@/data/sanityQueries";
import { urlFor } from "@/lib/sanity";
import { ArrowUpRight, FileText, HandCoins, HandHeart } from "lucide-react";

interface Props {
  /** true = full homepage band with heading; false = just the cards, for the Support Us page */
  heading?: boolean;
}

const { heading = true } = Astro.props;

const [campaign, giving, settings] = await Promise.all([getCampaign(), getGivingOptions(), getSiteSettings()]);

const raised = campaign?.raisedAmount ?? 0;
const goal = campaign?.goalAmount ?? 0;
const pct = goal > 0 ? Math.min(Math.round((raised / goal) * 100), 100) : 0;
const usd = (n: number) =>
  new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(n);

const ein = settings?.ein;
const mosqueUrl = campaign?.donorboxLink ?? "https://donorbox.org/build-the-new-sajjadia-mosque";
const generalUrl = giving?.generalDonorboxUrl ?? "https://donorbox.org/sajjadia-islamic-society-donations";

const khums = {
  orgName: giving?.khumsOrgName ?? "Sajjadia Islamic Society",
  validThrough: giving?.khumsValidThrough ?? "July 2027",
  khumsUrl: giving?.khumsUrl ?? "https://imam-us.org/products/khums-one-time",
  guideImageUrl: giving?.khumsGuideImage?.asset ? urlFor(giving.khumsGuideImage).width(1200).auto("format").url() : undefined,
  guideImageAlt: giving?.khumsGuideImage?.alt,
  ijazaUrl: giving?.ijazaUrl,
};

const Wrapper = heading ? "section" : "div";

const CARD = "flex flex-col rounded-2xl border border-border bg-card p-6 md:p-7";
const ICON_TILE = "flex h-12 w-12 items-center justify-center rounded-xl bg-muted text-foreground";
const TITLE = "mt-5 font-serif text-[1.7rem] leading-tight text-foreground";
const BODY = "mt-2 text-[17px] text-muted-foreground";
const RECEIPT = "text-sm text-muted-foreground";
const GIVE_BTN =
  "mt-3 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg bg-give px-5 text-base font-semibold " +
  "text-give-foreground transition-colors hover:bg-give/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring";
---

<Wrapper
  id={heading ? "support" : "ways-to-give"}
  aria-labelledby={heading ? "support-title" : undefined}
  class={heading ? "layout-full bg-muted py-16" : "scroll-mt-24"}
>
  <div class={heading ? "layout-base" : ""}>

    {heading && (
      <div class="mb-8">
        <h2 id="support-title" class="text-3xl text-foreground md:text-4xl">Support Sajjadia</h2>
        <p class="mt-2 max-w-2xl text-lg text-muted-foreground">Choose where your gift goes.</p>
      </div>
    )}

    <div class="grid gap-5 md:grid-cols-3">

      <!-- ── Sajjadia Mosque ── -->
      <article class={CARD}>
        <span class={ICON_TILE}>
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 21h18"></path>
            <path d="M5 21v-6a7 7 0 0 1 14 0v6"></path>
            <path d="M12 8V4.5"></path>
            <path d="M10.6 3.2a1.6 1.6 0 1 0 2.4 2"></path>
            <path d="M9 21v-4a3 3 0 0 1 6 0v4"></path>
          </svg>
        </span>
        <h3 class={TITLE}>Sajjadia Mosque</h3>
        <p class={BODY}>
          {giving?.mosqueDescription ?? "Help pay off our property at 2460 S Main St, Corona, and build our permanent Islamic Center."}
        </p>

        {goal > 0 && (
          <div class="mt-5">
            <div
              class="h-2.5 overflow-hidden rounded-full bg-muted"
              role="progressbar"
              aria-label="Mosque fund progress"
              aria-valuenow={pct}
              aria-valuemin="0"
              aria-valuemax="100"
            >
              <div class="h-full rounded-full bg-give" style={`width: ${pct}%`}></div>
            </div>
            <p class="mt-2 flex justify-between gap-3 text-sm text-muted-foreground">
              <span><strong class="text-base text-foreground">{usd(raised)}</strong> raised</span>
              <span>of {usd(goal)}</span>
            </p>
          </div>
        )}

        <div class="mt-auto pt-6">
          <p class={RECEIPT}>Tax receipt from Sajjadia{ein ? ` (EIN ${ein})` : ""}</p>
          <a href={mosqueUrl} target="_blank" rel="noopener noreferrer" class={GIVE_BTN}>
            Give to the mosque
            <ArrowUpRight size={18} aria-hidden="true" />
            <span class="sr-only">(opens Donorbox in a new tab)</span>
          </a>
        </div>
      </article>

      <!-- ── General donation ── -->
      <article class={CARD}>
        <span class={ICON_TILE}><HandHeart size={24} strokeWidth={1.75} aria-hidden="true" /></span>
        <h3 class={TITLE}>{giving?.generalTitle ?? "General donation"}</h3>
        <p class={BODY}>
          {giving?.generalDescription ??
            "Sadaqah and everyday support for weekly programs, Moharram and Ramadhan gatherings, and community services."}
        </p>

        <div class="mt-auto pt-6">
          <p class={RECEIPT}>Tax receipt from Sajjadia{ein ? ` (EIN ${ein})` : ""}</p>
          <a href={generalUrl} target="_blank" rel="noopener noreferrer" class={GIVE_BTN}>
            Donate
            <ArrowUpRight size={18} aria-hidden="true" />
            <span class="sr-only">(opens Donorbox in a new tab)</span>
          </a>
        </div>
      </article>

      <!-- ── Khums ── -->
      <article class={CARD}>
        <span class={ICON_TILE}><HandCoins size={24} strokeWidth={1.75} aria-hidden="true" /></span>
        <h3 class={TITLE}>Khums</h3>
        <p class={BODY}>
          {giving?.khumsDescription ?? "Allocate your Khums to the Sajjadia Islamic Center through I.M.A.M., under our Ijaza."}
        </p>
        <p class="mt-3 text-sm text-muted-foreground">
          Ijaza valid through {khums.validThrough}.
          {khums.ijazaUrl && (
            <a
              href={khums.ijazaUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="ml-1 inline-flex items-center gap-1 font-semibold text-secondary underline-offset-4 hover:underline"
            >
              <FileText size={14} aria-hidden="true" />
              View Ijaza
            </a>
          )}
        </p>

        <div class="mt-auto pt-6">
          <p class={RECEIPT}>Official Khums receipt from I.M.A.M.</p>
          <div class="mt-3">
            <KhumsGuide {...khums} client:visible />
          </div>
        </div>
      </article>

    </div>

    <p class="mt-6 text-sm text-muted-foreground">
      Sajjadia Islamic Society is a registered 501(c)(3) nonprofit{ein ? `, EIN ${ein}` : ""}. Donations made through
      Donorbox are tax-deductible as allowed by law.
    </p>
  </div>
</Wrapper>
