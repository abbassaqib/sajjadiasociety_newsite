---
// One album as a card: cover photo, title, date and photo count.
// Tapping the cover opens the whole album in the full-screen viewer.
// The other photos are hidden links the viewer reads; they aren't shown
// or focusable on the page.
import PhotoViewer from "@/components/PhotoViewer.astro";
import { formatMonthYear, photoAlt, photoCropped, photoFull, type Album } from "@/lib/albums";
import { Images } from "lucide-react";

interface Props {
  album: Album;
}

const { album } = Astro.props;

const photos = (album.photos ?? [])
  .map((photo, i) => ({ photo, full: photoFull(photo), alt: photoAlt(photo, album, i) }))
  .filter((item) => item.full);

const cover = photos[0];
const coverImage = cover ? photoCropped(cover.photo, 640, 480) : null;
const lqip = cover?.photo.asset?.metadata?.lqip;
const date = formatMonthYear(album.date);
const count = photos.length;
const countLabel = `${count} ${count === 1 ? "photo" : "photos"}`;
---

{cover && coverImage && (
  <article class="flex h-full flex-col overflow-hidden rounded-xl border border-border bg-card">
    <div data-pswp-gallery>
      <a
        href={cover.full!.src}
        data-pswp-width={cover.full!.width}
        data-pswp-height={cover.full!.height}
        data-caption={cover.photo.caption ?? ""}
        aria-label={`Open ${album.title}, ${countLabel}`}
        class="group relative block overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
      >
        <img
          src={coverImage.src}
          srcset={coverImage.srcset}
          sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
          alt={cover.alt}
          width="640"
          height="480"
          loading="lazy"
          decoding="async"
          class="aspect-[4/3] w-full bg-muted bg-cover bg-center object-cover transition-transform duration-300 group-hover:scale-[1.03]"
          style={lqip ? `background-image: url(${lqip})` : undefined}
        />
        <span class="absolute bottom-2 right-2 inline-flex items-center gap-1.5 rounded-md bg-black/75 px-2 py-1 text-xs font-semibold text-white">
          <Images size={14} aria-hidden="true" />
          {countLabel}
        </span>
      </a>

      {photos.slice(1).map(({ photo, full }) => (
        <a
          href={full!.src}
          data-pswp-width={full!.width}
          data-pswp-height={full!.height}
          data-caption={photo.caption ?? ""}
          hidden
        ></a>
      ))}
    </div>

    <div class="flex flex-1 flex-col gap-1 p-4">
      <h3 class="font-semibold text-foreground">{album.title}</h3>
      {date && <p class="text-sm text-muted-foreground">{date}</p>}
      {album.description && <p class="mt-1 text-sm leading-relaxed text-muted-foreground">{album.description}</p>}
    </div>
  </article>
)}

<PhotoViewer />
