---
// Thumbnail grid for one album. Tapping a photo opens the whole album in a
// full-screen viewer (PhotoSwipe): swipe or arrow keys to move, pinch or
// tap to zoom, Esc or the close button to exit.
// Photos from "Concept renderings" albums are labeled on the thumbnail and
// in the viewer so nobody mistakes them for the finished building.
import PhotoViewer from "@/components/PhotoViewer.astro";
import { photoAlt, photoFull, photoThumb, type Album } from "@/lib/albums";

interface Props {
  album: Album;
}

const { album } = Astro.props;

const concept = album.category === "renderings";

const photos = (album.photos ?? [])
  .map((photo, i) => ({
    photo,
    full: photoFull(photo),
    thumb: photoThumb(photo),
    alt: photoAlt(photo, album, i),
    lqip: photo.asset?.metadata?.lqip,
  }))
  .filter((item) => item.full);
---

{photos.length > 0 && (
  <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3" data-pswp-gallery>
    {photos.map(({ photo, full, thumb, alt, lqip }) => (
      <li>
        <a
          href={full!.src}
          data-pswp-width={full!.width}
          data-pswp-height={full!.height}
          data-caption={photo.caption ?? ""}
          data-concept={concept ? "true" : undefined}
          class="group relative block overflow-hidden rounded-xl bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          <img
            src={thumb.src}
            srcset={thumb.srcset}
            sizes="(min-width: 1024px) 33vw, 50vw"
            alt={alt}
            width="600"
            height="450"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full bg-cover bg-center object-cover transition-transform duration-300 group-hover:scale-[1.03]"
            style={lqip ? `background-image: url(${lqip})` : undefined}
          />
          {concept && (
            <span
              class="absolute left-2 top-2 rounded-md bg-black/75 px-2 py-1 text-xs font-semibold text-white"
              aria-hidden="true"
            >
              Concept rendering
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
)}

<PhotoViewer />
