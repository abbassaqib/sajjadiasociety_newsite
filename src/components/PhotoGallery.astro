---
// Thumbnail grid for one album. Tapping a photo opens the whole album in a
// full-screen viewer (PhotoSwipe): swipe or arrow keys to move, pinch or
// tap to zoom, Esc or the close button to exit.
// Photos from "Concept renderings" albums are labeled on the thumbnail and
// in the viewer so nobody mistakes them for the finished building.
import { photoAlt, photoFull, photoThumb, type Album } from "@/lib/albums";

interface Props {
  album: Album;
}

const { album } = Astro.props;

const concept = album.category === "renderings";

const photos = (album.photos ?? [])
  .map((photo, i) => ({
    photo,
    full: photoFull(photo),
    thumb: photoThumb(photo),
    alt: photoAlt(photo, album, i),
    lqip: photo.asset?.metadata?.lqip,
  }))
  .filter((item) => item.full);
---

{photos.length > 0 && (
  <ul class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-3" data-pswp-gallery>
    {photos.map(({ photo, full, thumb, alt, lqip }) => (
      <li>
        <a
          href={full!.src}
          data-pswp-width={full!.width}
          data-pswp-height={full!.height}
          data-caption={photo.caption ?? ""}
          data-concept={concept ? "true" : undefined}
          class="group relative block overflow-hidden rounded-xl bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
        >
          <img
            src={thumb.src}
            srcset={thumb.srcset}
            sizes="(min-width: 1024px) 33vw, 50vw"
            alt={alt}
            width="600"
            height="450"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full bg-cover bg-center object-cover transition-transform duration-300 group-hover:scale-[1.03]"
            style={lqip ? `background-image: url(${lqip})` : undefined}
          />
          {concept && (
            <span class="absolute left-2 top-2 rounded-md bg-black/75 px-2 py-1 text-xs font-semibold text-white">
              Concept rendering
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
)}

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  // One viewer for every gallery on the page; each gallery opens on its own.
  const lightbox = new PhotoSwipeLightbox({
    gallery: "[data-pswp-gallery]",
    children: "a",
    // The main viewer code downloads only when someone opens a photo
    pswpModule: () => import("photoswipe"),
    bgOpacity: 0.95,
    closeTitle: "Close",
    zoomTitle: "Zoom",
    arrowPrevTitle: "Previous photo",
    arrowNextTitle: "Next photo",
    indexIndicatorSep: " of ",
  });

  // Caption bar: "Concept rendering" label and the photo's caption
  lightbox.on("uiRegister", () => {
    lightbox.pswp?.ui?.registerElement({
      name: "caption",
      order: 9,
      isButton: false,
      appendTo: "root",
      onInit: (el, pswp) => {
        el.classList.add("pswp__caption");
        el.setAttribute("aria-live", "polite");

        pswp.on("change", () => {
          const link = pswp.currSlide?.data.element as HTMLElement | undefined;
          el.replaceChildren();

          if (link?.dataset.concept) {
            const label = document.createElement("span");
            label.className = "pswp__concept";
            label.textContent = "Concept rendering";
            el.append(label);
          }

          const caption = link?.dataset.caption;
          if (caption) {
            const text = document.createElement("span");
            text.textContent = caption;
            el.append(text);
          }

          el.hidden = el.childElementCount === 0;
        });
      },
    });
  });

  lightbox.init();
</script>

<style is:global>
  .pswp__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2.5rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(to top, rgb(0 0 0 / 0.8), transparent);
    color: #fff;
    font-size: 0.95rem;
    line-height: 1.45;
    text-align: center;
    pointer-events: none;
  }
  .pswp__caption[hidden] {
    display: none;
  }
  .pswp__concept {
    border-radius: 0.375rem;
    background: rgb(255 255 255 / 0.18);
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
