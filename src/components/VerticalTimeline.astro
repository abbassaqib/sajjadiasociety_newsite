---
import { urlFor } from "@/lib/sanity";
import Lightbox from "@/components/Lightbox.astro";
import { Landmark, CalendarDays, MapPin, HandCoins, Flag, FileText, Star } from "lucide-react";

interface Props {
  events: any[];
}

const { events } = Astro.props;

// One color for everything — categories are told apart by icon, not hue
const categoryConfig: Record<string, { label: string; Icon: any }> = {
  milestone: { label: "Milestone", Icon: Landmark },
  program:   { label: "Program",   Icon: CalendarDays },
  location:  { label: "Location",  Icon: MapPin },
  campaign:  { label: "Campaign",  Icon: HandCoins },
  future:    { label: "Future",    Icon: Flag },
};

// timeZone UTC so a "2019-01-01" date never shows as December 2018
function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString("en-US", {
    month: "long",
    year: "numeric",
    timeZone: "UTC",
  });
}
---

<div class="relative">

  <!-- Vertical line through the center of the icons -->
  <div class="absolute left-5 top-4 bottom-4 w-px -translate-x-1/2 bg-border" aria-hidden="true"></div>

  <ol class="flex flex-col gap-5">
    {events.map((event) => {
      const cfg = categoryConfig[event.category] ?? categoryConfig.future;
      const CatIcon = cfg.Icon;
      const isUpcoming = event.status === "upcoming";
      const isCurrent = event.status === "current";
      const images = (event.images ?? []).filter((img: any) => img?.image);
      const docs = (event.documents ?? []).filter((d: any) => d?.file?.asset?.url);

      return (
        <li class="flex gap-4">

          <!-- Icon on the line: filled = past/current, outlined = upcoming -->
          <div
            class={`relative z-10 mt-4 flex h-10 w-10 flex-none items-center justify-center rounded-full ${
              isUpcoming
                ? "border-2 border-primary bg-card text-primary"
                : "bg-primary text-primary-foreground"
            }`}
          >
            <CatIcon size={18} strokeWidth={1.75} aria-hidden="true" />
          </div>

          <!-- Card -->
          <details
            class={`group min-w-0 flex-1 overflow-hidden rounded-xl border bg-card ${
              isUpcoming ? "border-dashed border-border" : "border-border"
            } ${event.isFeatured ? "shadow-md" : ""}`}
          >
            <summary class="cursor-pointer list-none p-4 [&::-webkit-details-marker]:hidden">

              <div class="mb-1.5 flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-foreground">
                  {cfg.label}
                </span>
                {isCurrent && (
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-muted px-2.5 py-0.5 text-xs font-semibold text-foreground">
                    <span class="h-2 w-2 animate-pulse rounded-full bg-primary"></span>
                    In progress
                  </span>
                )}
                {isUpcoming && (
                  <span class="rounded-full border border-border px-2.5 py-0.5 text-xs font-semibold text-muted-foreground">
                    Upcoming
                  </span>
                )}
                {event.isFeatured && (
                  <Star size={14} aria-label="Featured" className="fill-current text-muted-foreground" />
                )}
              </div>

              <p class="mb-1 text-sm text-muted-foreground">{formatDate(event.date)}</p>

              <p class={`font-semibold leading-snug text-foreground ${event.isFeatured ? "text-lg" : ""}`}>
                {event.title}
              </p>

              <p class="mt-2 text-sm font-semibold text-secondary group-open:hidden">Show details</p>
              <p class="mt-2 hidden text-sm font-semibold text-secondary group-open:block">Hide details</p>
            </summary>

            <div class="border-t border-border px-4 pb-4 pt-3">
              {event.description && (
                <p class="mb-4 text-[15px] leading-relaxed text-muted-foreground">{event.description}</p>
              )}

              {images.length > 0 && (
                <div class="mb-3 grid grid-cols-2 gap-2">
                  {images.slice(0, 4).map((img: any, idx: number) => {
                    const thumb = urlFor(img.image).width(300).height(200).fit("crop").url();
                    const full = urlFor(img.image).width(1200).url();
                    return (
                      <Lightbox
                        id={`${event._id}-${idx}`}
                        src={full}
                        alt={img.caption ?? event.title}
                        thumbnailSrc={thumb}
                      />
                    );
                  })}
                </div>
              )}

              {docs.length > 0 && (
                <ul class="flex flex-col gap-1.5">
                  {docs.map((doc: any) => (
                    <li>
                      <a
                        href={doc.file.asset.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 text-sm font-semibold text-secondary underline-offset-2 hover:underline"
                      >
                        <FileText size={16} aria-hidden="true" />
                        {doc.label ?? "View document"}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </details>

        </li>
      );
    })}
  </ol>

  <!-- Legend -->
  <div class="mt-8 flex flex-wrap gap-x-5 gap-y-2 border-t border-border pt-6">
    {Object.values(categoryConfig).map(({ label, Icon }) => (
      <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
        <Icon size={14} aria-hidden="true" />
        {label}
      </span>
    ))}
    <span class="flex items-center gap-1.5 text-xs text-muted-foreground">
      <span class="h-3.5 w-3.5 rounded-full border-2 border-primary" aria-hidden="true"></span>
      Upcoming
    </span>
  </div>

</div>