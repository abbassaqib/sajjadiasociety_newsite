---
// The full-screen photo viewer (PhotoSwipe) and its caption bar.
// Used by PhotoGallery and AlbumCard. It works on every element marked
// data-pswp-gallery: the links inside each one become that album's photos.
// Astro includes this script once per page, however many galleries there are.
---

<script>
  import PhotoSwipeLightbox from "photoswipe/lightbox";
  import "photoswipe/style.css";

  // One viewer for every gallery on the page; each gallery opens on its own.
  const lightbox = new PhotoSwipeLightbox({
    gallery: "[data-pswp-gallery]",
    children: "a",
    // The main viewer code downloads only when someone opens a photo
    pswpModule: () => import("photoswipe"),
    bgOpacity: 0.95,
    closeTitle: "Close",
    zoomTitle: "Zoom",
    arrowPrevTitle: "Previous photo",
    arrowNextTitle: "Next photo",
    indexIndicatorSep: " of ",
  });

  // Caption bar: "Concept rendering" label and the photo's caption
  lightbox.on("uiRegister", () => {
    lightbox.pswp?.ui?.registerElement({
      name: "caption",
      order: 9,
      isButton: false,
      appendTo: "root",
      onInit: (el, pswp) => {
        el.classList.add("pswp__caption");
        el.setAttribute("aria-live", "polite");

        pswp.on("change", () => {
          const link = pswp.currSlide?.data.element as HTMLElement | undefined;
          el.replaceChildren();

          if (link?.dataset.concept) {
            const label = document.createElement("span");
            label.className = "pswp__concept";
            label.textContent = "Concept rendering";
            el.append(label);
          }

          const caption = link?.dataset.caption;
          if (caption) {
            const text = document.createElement("span");
            text.textContent = caption;
            el.append(text);
          }

          el.hidden = el.childElementCount === 0;
        });
      },
    });
  });

  lightbox.init();
</script>

<style is:global>
  .pswp__caption {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 2.5rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
    background: linear-gradient(to top, rgb(0 0 0 / 0.8), transparent);
    color: #fff;
    font-size: 0.95rem;
    line-height: 1.45;
    text-align: center;
    pointer-events: none;
  }
  .pswp__caption[hidden] {
    display: none;
  }
  .pswp__concept {
    border-radius: 0.375rem;
    background: rgb(255 255 255 / 0.18);
    padding: 0.2rem 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
  }
</style>
