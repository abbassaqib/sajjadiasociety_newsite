---
// A YouTube video that shows only a thumbnail and play button until tapped.
// YouTube's player (several hundred KB) loads only when someone plays it,
// using youtube-nocookie.com so no tracking cookies are set before then.

interface Props {
  /** The 11-character YouTube video ID */
  id: string;
  title?: string;
}

const { id, title = "Video" } = Astro.props;
---

<div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black" data-yt={id} data-yt-title={title}>
  <button
    type="button"
    class="group absolute inset-0 h-full w-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-white"
    aria-label={`Play video: ${title}`}
  >
    <img
      src={`https://i.ytimg.com/vi/${id}/hqdefault.jpg`}
      alt=""
      width="480"
      height="360"
      loading="lazy"
      decoding="async"
      class="h-full w-full object-cover opacity-90 transition-opacity group-hover:opacity-100"
    />
    <span
      class="absolute left-1/2 top-1/2 flex h-14 w-20 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-2xl bg-black/75 transition-colors group-hover:bg-[#FF0000] group-focus-visible:bg-[#FF0000]"
      aria-hidden="true"
    >
      <svg viewBox="0 0 24 24" width="30" height="30" fill="#fff"><path d="M8 5v14l11-7z" /></svg>
    </span>
  </button>
</div>

<script>
  // One listener for every video on the page
  document.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-yt] > button");
    if (!button) return;

    const wrapper = button.parentElement as HTMLElement;
    const iframe = document.createElement("iframe");
    iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(wrapper.dataset.yt ?? "")}?autoplay=1&rel=0`;
    iframe.title = wrapper.dataset.ytTitle ?? "YouTube video";
    iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
    iframe.allowFullscreen = true;
    iframe.className = "absolute inset-0 h-full w-full";

    button.replaceWith(iframe);
    iframe.focus();
  });
</script>
