---
import DetailDialog from "@/components/DetailDialog";
import { getAnnouncements, getUpcomingPrograms, getPastPrograms } from "@/data/sanityQueries";
import { announcementToItem, eventToItem, type DetailItem } from "@/lib/detailItems";
import { Megaphone, Pin, Repeat } from "lucide-react";

// Fetch one more than we show, so we know whether to show "See all"
const [annDocs, upcomingDocs, pastDocs] = await Promise.all([
  getAnnouncements(4),
  getUpcomingPrograms(4),
  getPastPrograms(3),
]);

const announcements = (annDocs ?? []).map(announcementToItem);
const upcoming = (upcomingDocs ?? []).map(eventToItem);
const recent = (pastDocs ?? []).map(eventToItem);

const topAnnouncements = announcements.slice(0, 3);
const moreAnnouncements = announcements.length > 3;

// Nothing upcoming? Show recent events so the homepage never looks inactive
const showRecent = upcoming.length === 0;
const events = (showRecent ? recent : upcoming).slice(0, 3);
const moreEvents = showRecent ? recent.length > 0 : upcoming.length > 3;

const weekAhead = Date.now() + 7 * 24 * 60 * 60 * 1000;
const isThisWeek = (item: DetailItem) =>
  !!item.startISO && !item.isPast && new Date(item.startISO).getTime() <= weekAhead;

// Previous / Next in the dialog moves through what's shown here
const dialogItems = [...topAnnouncements, ...events];

const ROW =
  "group flex items-center gap-4 rounded-2xl border border-border bg-card p-3 pr-4 transition-colors " +
  "hover:border-foreground/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring";
const SEE_ALL = "font-semibold text-secondary underline-offset-4 hover:underline";
---

<section id="news-events" aria-labelledby="home-news-title" class="layout-full bg-background py-16">
  <div class="layout-base">
    <h2 id="home-news-title" class="mb-8 text-3xl text-foreground md:text-4xl">News &amp; events</h2>

    <div class="grid gap-10 lg:grid-cols-2">

      <!-- ── Announcements ── -->
      <div>
        <div class="mb-4 flex items-baseline justify-between gap-4">
          <h3 class="text-lg font-semibold text-muted-foreground">Announcements</h3>
          {moreAnnouncements && <a href="/news-events#announcements" class={SEE_ALL}>See all</a>}
        </div>

        {topAnnouncements.length > 0 ? (
          <ul class="flex flex-col gap-3">
            {topAnnouncements.map((item) => (
              <li>
                <a href={item.path} data-detail-id={item.id} class={ROW}>
                  {item.imageThumb ? (
                    <img src={item.imageThumb} alt="" width="72" height="72" loading="lazy" class="h-[72px] w-[72px] flex-none rounded-xl bg-muted object-cover" />
                  ) : (
                    <span class="flex h-[72px] w-[72px] flex-none items-center justify-center rounded-xl bg-muted text-muted-foreground">
                      <Megaphone size={24} strokeWidth={1.5} aria-hidden="true" />
                    </span>
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="flex flex-wrap items-center gap-x-3 text-sm text-muted-foreground">
                      {item.category}
                      {item.isPinned && (
                        <span class="inline-flex items-center gap-1 font-semibold text-foreground">
                          <Pin size={13} aria-hidden="true" />
                          Pinned
                        </span>
                      )}
                    </span>
                    <span class="mt-0.5 block font-semibold leading-snug text-foreground underline-offset-2 group-hover:underline sm:text-lg">
                      {item.title}
                    </span>
                    {item.postedLabel && (
                      <span class="mt-0.5 block text-sm text-muted-foreground">Posted {item.postedLabel}</span>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="rounded-2xl border border-dashed border-border p-6 text-muted-foreground">
            Nothing new right now. Join our WhatsApp group at the bottom of the page to hear about updates first.
          </p>
        )}
      </div>

      <!-- ── Events ── -->
      <div>
        <div class="mb-4 flex items-baseline justify-between gap-4">
          <h3 class="text-lg font-semibold text-muted-foreground">
            {showRecent ? "Recent events" : "Upcoming events"}
          </h3>
          {moreEvents && <a href="/news-events#events" class={SEE_ALL}>See all</a>}
        </div>

        {events.length > 0 ? (
          <ul class="flex flex-col gap-3">
            {events.map((item) => (
              <li>
                <a href={item.path} data-detail-id={item.id} class={ROW}>
                  <span class="flex h-[72px] w-[72px] flex-none flex-col items-center justify-center rounded-xl bg-muted" aria-hidden="true">
                    <span class="text-sm font-semibold text-muted-foreground">{item.shortDate?.dow}</span>
                    <span class="font-serif text-2xl leading-none text-foreground">{item.shortDate?.day}</span>
                    <span class="text-sm text-muted-foreground">{item.shortDate?.month}</span>
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted-foreground">
                      {isThisWeek(item) && (
                        <span class="rounded-full bg-primary px-2 py-0.5 text-xs font-semibold text-primary-foreground">This week</span>
                      )}
                      {item.category}
                      {item.recurrence && (
                        <span class="inline-flex items-center gap-1">
                          <Repeat size={13} aria-hidden="true" />
                          Recurring
                        </span>
                      )}
                    </span>
                    <span class="mt-0.5 block font-semibold leading-snug text-foreground underline-offset-2 group-hover:underline sm:text-lg">
                      {item.title}
                    </span>
                    <span class="mt-0.5 block truncate text-sm text-muted-foreground">
                      <span class="sr-only">{item.dateLabel}, </span>{item.summary}
                    </span>
                  </span>
                  {item.imageThumb && (
                    <img src={item.imageThumb} alt="" width="58" height="72" loading="lazy" class="hidden h-[72px] w-[58px] flex-none rounded-lg bg-muted object-cover sm:block" />
                  )}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="rounded-2xl border border-dashed border-border p-6 text-muted-foreground">
            No events are scheduled yet. Weekly programs continue as usual; join our WhatsApp group for venue updates.
          </p>
        )}
      </div>

    </div>
  </div>

  <DetailDialog items={dialogItems} client:load />
</section>
