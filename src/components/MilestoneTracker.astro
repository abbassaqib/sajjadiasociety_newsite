---
// Mosque fund milestones as a vertical list, for the Sajjadia Mosque page.
// Every milestone shows its label, amount and status at once, so nothing
// is hidden behind a click (the old version's click popup never filled in
// its status line, and wasn't reachable by keyboard).
import { Check } from "lucide-react";

interface Milestone {
  amount?: number;
  label?: string;
  reached?: boolean;
}

interface Props {
  milestones?: Milestone[];
}

const { milestones = [] } = Astro.props;

const sorted = milestones
  .filter((m): m is Required<Milestone> => typeof m?.amount === "number" && !!m?.label)
  .sort((a, b) => a.amount - b.amount);

// The first milestone not yet reached is the one being worked toward
const nextIndex = sorted.findIndex((m) => !m.reached);

const usd = (n: number) =>
  new Intl.NumberFormat("en-US", { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(n);
---

{sorted.length > 0 && (
  <ol class="max-w-2xl">
    {sorted.map((m, i) => {
      const state = m.reached ? "reached" : i === nextIndex ? "next" : "upcoming";
      const isLast = i === sorted.length - 1;
      const lineDone = m.reached && sorted[i + 1]?.reached;

      return (
        <li class="relative flex gap-4 pb-8 last:pb-0">
          {!isLast && (
            <span
              class={`absolute left-5 top-10 bottom-0 w-0.5 -translate-x-1/2 ${lineDone ? "bg-primary" : "bg-border"}`}
              aria-hidden="true"
            ></span>
          )}

          <span
            class={`relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 text-sm font-semibold ${
              state === "reached"
                ? "border-primary bg-primary text-primary-foreground"
                : state === "next"
                  ? "border-primary bg-background text-primary"
                  : "border-border bg-background text-muted-foreground"
            }`}
            aria-hidden="true"
          >
            {state === "reached" ? <Check size={18} strokeWidth={3} /> : i + 1}
          </span>

          <div class="pt-1.5">
            <p class="text-lg font-semibold text-foreground">{m.label}</p>
            <p class="mt-0.5 text-muted-foreground">{usd(m.amount)}</p>
            {state === "reached" && <p class="mt-1 text-sm font-semibold text-primary">Reached</p>}
            {state === "next" && <p class="mt-1 text-sm font-semibold text-foreground">Up next</p>}
          </div>
        </li>
      );
    })}
  </ol>
)}
