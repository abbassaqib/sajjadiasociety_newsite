---
import BaseLayout from "@/layouts/BaseLayout.astro";
import AlbumBlock from "@/components/AlbumBlock.astro";
import CampaignProgress from "@/components/CampaignProgress.astro";
import Lightbox from "@/components/Lightbox.astro";
import MilestoneTracker from "@/components/MilestoneTracker.astro";
import { getAlbums, getCampaign } from "@/data/sanityQueries";
import { urlFor } from "@/lib/sanity";
import { portableTextToHtml } from "@/lib/portableText";
import type { Album } from "@/lib/albums";
import { ArrowUpRight } from "lucide-react";

const [campaign, albums] = await Promise.all([
  getCampaign(),
  getAlbums(["renderings", "property", "construction"]) as Promise<Album[]>,
]);

const title = campaign?.title ?? "Sajjadia Mosque";
const tagline = campaign?.tagline;
const raised = campaign?.raisedAmount ?? 0;
const goal = campaign?.goalAmount ?? 0;
const donateUrl = campaign?.donorboxLink ?? "https://donorbox.org/build-the-new-sajjadia-mosque";
const milestones = campaign?.milestones ?? [];

// Sanity "date" fields are plain dates (2026-10-07). Format those in UTC so
// they don't shift a day; full timestamps are shown in Pacific time.
function formatDate(value: string): string {
  const dateOnly = /^\d{4}-\d{2}-\d{2}$/.test(value);
  return new Intl.DateTimeFormat("en-US", {
    month: "long",
    day: "numeric",
    year: "numeric",
    timeZone: dateOnly ? "UTC" : "America/Los_Angeles",
  }).format(new Date(dateOnly ? `${value}T00:00:00Z` : value));
}

const lastUpdated = campaign?.lastUpdated ? formatDate(campaign.lastUpdated) : null;

// Newest first
const updates = [...(campaign?.updates ?? [])]
  .filter((u: any) => u?.title && u?.date)
  .sort((a: any, b: any) => String(b.date).localeCompare(String(a.date)));

const storyHtml = portableTextToHtml(campaign?.story, {
  p: "mb-5 text-lg leading-relaxed text-foreground",
  h3: "mt-10 mb-3 text-2xl text-foreground",
  h4: "mt-8 mb-2 text-xl font-semibold text-foreground",
  ul: "mb-5 list-disc space-y-2 pl-6 text-lg leading-relaxed text-foreground",
  ol: "mb-5 list-decimal space-y-2 pl-6 text-lg leading-relaxed text-foreground",
  link: "font-semibold text-secondary underline underline-offset-4",
  img: "my-8 w-full rounded-xl",
});

// Albums from Sanity, grouped by category (newest album first within each).
// Albums with no photos or videos yet are skipped.
const withContent = (albums ?? []).filter((a) => (a.photos?.length ?? 0) + (a.videos?.length ?? 0) > 0);
const renderings = withContent.filter((a) => a.category === "renderings");
const property = withContent.filter((a) => a.category === "property");
const construction = withContent.filter((a) => a.category === "construction");

// Sections alternate between plain and muted backgrounds, counting only the
// ones that actually have content
const visibleSections = [
  renderings.length > 0 && "renderings",
  milestones.length > 0 && "milestones",
  updates.length > 0 && "updates",
  storyHtml && "story",
  property.length > 0 && "property",
  construction.length > 0 && "construction",
].filter(Boolean);
const tone = (key: string) => (visibleSections.indexOf(key) % 2 === 1 ? "bg-muted" : "");

const GIVE_BTN =
  "inline-flex min-h-12 items-center justify-center gap-2 rounded-lg bg-give px-7 text-base font-semibold " +
  "text-give-foreground transition-colors hover:bg-give/90 focus-visible:outline-none focus-visible:ring-2 " +
  "focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-sidebar";
---

<BaseLayout
  pageTitle="Sajjadia Mosque"
  description={tagline ?? "Plans, progress, and updates on the new Sajjadia Mosque at 2460 S Main St, Corona, California."}
>

  <!-- ── Header: the project, its progress, and the one way to give ── -->
  <section class="layout-full bg-sidebar py-14 text-sidebar-foreground md:py-20">
    <div class="layout-base">
      <h1 class="text-4xl md:text-5xl">{title}</h1>
      {tagline && (
        <p class="mt-3 max-w-2xl text-lg text-sidebar-foreground/75 md:text-xl">{tagline}</p>
      )}

      <div class="mt-10 max-w-2xl">
        {goal > 0 && <CampaignProgress raised={raised} goal={goal} tone="dark" />}

        <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href={donateUrl} target="_blank" rel="noopener noreferrer" class={GIVE_BTN}>
            Support the build
            <ArrowUpRight size={18} aria-hidden="true" />
            <span class="sr-only">(opens Donorbox in a new tab)</span>
          </a>
          {lastUpdated && (
            <p class="text-sm text-sidebar-foreground/75">Totals updated {lastUpdated}</p>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Concept renderings: what the mosque will look like ── -->
  {renderings.length > 0 && (
    <section class={`layout-full py-14 md:py-16 ${tone("renderings")}`} aria-labelledby="renderings-title">
      <div class="layout-base">
        <h2 id="renderings-title" class="text-3xl text-foreground">Concept renderings</h2>
        <p class="mt-2 mb-8 max-w-3xl text-muted-foreground">
          These are artist's concept renderings, not photos. The final design may change.
        </p>
        <div class="flex flex-col gap-12">
          {renderings.map((album) => <AlbumBlock album={album} showTitle={renderings.length > 1} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ── Milestones ── -->
  {milestones.length > 0 && (
    <section class={`layout-full py-14 md:py-16 ${tone("milestones")}`} aria-labelledby="milestones-title">
      <div class="layout-base">
        <h2 id="milestones-title" class="mb-8 text-3xl text-foreground">Milestones</h2>
        <MilestoneTracker milestones={milestones} />
      </div>
    </section>
  )}

  <!-- ── Updates (only on this page, not in News & Events) ── -->
  {updates.length > 0 && (
    <section class={`layout-full py-14 md:py-16 ${tone("updates")}`} aria-labelledby="updates-title">
      <div class="layout-base">
        <h2 id="updates-title" class="mb-8 text-3xl text-foreground">Updates</h2>
        <ol class="flex max-w-3xl flex-col gap-10">
          {updates.map((update: any, i: number) => (
            <li>
              <article>
                <time datetime={update.date} class="text-sm font-semibold text-muted-foreground">
                  {formatDate(update.date)}
                </time>
                <h3 class="mt-1 text-xl font-semibold text-foreground">{update.title}</h3>
                {update.body && (
                  <p class="mt-2 whitespace-pre-line leading-relaxed text-foreground">{update.body}</p>
                )}
                {update.image?.asset && (
                  <div class="mt-4 max-w-xl">
                    <Lightbox
                      id={`update-img-${i}`}
                      src={urlFor(update.image).width(1800).auto("format").url()}
                      thumbnailSrc={urlFor(update.image).width(900).auto("format").url()}
                      alt={update.title}
                    />
                  </div>
                )}
              </article>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <!-- ── The project ── -->
  {storyHtml && (
    <section class={`layout-full py-14 md:py-16 ${tone("story")}`} aria-labelledby="story-title">
      <div class="layout-base">
        <h2 id="story-title" class="mb-8 text-3xl text-foreground">About the project</h2>
        <div class="max-w-3xl" set:html={storyHtml} />
      </div>
    </section>
  )}

  <!-- ── The property today ── -->
  {property.length > 0 && (
    <section class={`layout-full py-14 md:py-16 ${tone("property")}`} aria-labelledby="property-title">
      <div class="layout-base">
        <h2 id="property-title" class="mb-8 text-3xl text-foreground">The property today</h2>
        <div class="flex flex-col gap-12">
          {property.map((album) => <AlbumBlock album={album} showTitle={property.length > 1} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ── Construction ── -->
  {construction.length > 0 && (
    <section class={`layout-full py-14 md:py-16 ${tone("construction")}`} aria-labelledby="construction-title">
      <div class="layout-base">
        <h2 id="construction-title" class="mb-8 text-3xl text-foreground">Construction</h2>
        <div class="flex flex-col gap-12">
          {construction.map((album) => <AlbumBlock album={album} showTitle={construction.length > 1} />)}
        </div>
      </div>
    </section>
  )}

  <!-- ── Closing: thanks, and the other ways to give (no second gold button) ── -->
  <section class="layout-full border-t border-border py-14 md:py-16">
    <div class="layout-base">
      <div class="max-w-3xl">
        {campaign?.thankYouMessage && (
          <p class="text-xl leading-relaxed text-foreground">{campaign.thankYouMessage}</p>
        )}
        <p class="mt-4 text-muted-foreground">
          Sajjadia Islamic Society is a registered 501(c)(3) nonprofit. Donations are tax-deductible as allowed by law.
        </p>
        <a
          href="/donate"
          class="mt-6 inline-block font-semibold text-secondary underline-offset-4 hover:underline"
        >
          See all ways to give
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
