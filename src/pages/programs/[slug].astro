---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DetailView from "@/components/DetailView";
import { sanityClient } from "@/lib/sanity";
import { eventToItem, EVENT_FIELDS } from "@/lib/detailItems";
import { ArrowLeft } from "lucide-react";

export async function getStaticPaths() {
  const docs = await sanityClient.fetch(
    `*[_type == "program" && isPublished == true && defined(slug.current)]{ ${EVENT_FIELDS} }`
  );
  return docs.map((doc: any) => ({ params: { slug: doc.slug.current }, props: { doc } }));
}

const { doc } = Astro.props;
const item = eventToItem(doc);
---

<BaseLayout pageTitle={item.title} description={item.metaDescription} ogImage={item.imageOg}>
  <main class="layout-base gap-6 py-10">
    <a href="/news-events" class="inline-flex w-fit items-center gap-2 font-semibold text-secondary underline-offset-4 hover:underline">
      <ArrowLeft size={18} aria-hidden="true" />
      All news and events
    </a>
    <DetailView item={item} mode="page" client:load />
  </main>
</BaseLayout>
