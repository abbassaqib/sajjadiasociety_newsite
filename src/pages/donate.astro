---
// Support Us: the three ways to give. The mosque campaign story, progress,
// photos and videos now live on the Sajjadia Mosque page.
import BaseLayout from "@/layouts/BaseLayout.astro";
import GivingCards from "@/components/GivingCards.astro";
---

<BaseLayout
  pageTitle="Support Us"
  description="Give to the Sajjadia Mosque building fund, make a general donation, or allocate your Khums to Sajjadia Islamic Society through I.M.A.M."
>
  <section class="layout-full py-12 md:py-16">
    <div class="layout-base">
      <h1 class="text-4xl text-foreground md:text-5xl">Support Sajjadia</h1>
      <p class="mt-2 mb-8 max-w-2xl text-lg text-muted-foreground">
        Choose where your gift goes.
      </p>
      <GivingCards heading={false} />
    </div>
  </section>
</BaseLayout>
