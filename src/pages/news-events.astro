---
import BaseLayout from "@/layouts/BaseLayout.astro";
import DetailDialog from "@/components/DetailDialog";
import { getAnnouncements, getUpcomingPrograms, getPastPrograms } from "@/data/sanityQueries";
import { announcementToItem, eventToItem } from "@/lib/detailItems";
import { Megaphone, Pin, Repeat } from "lucide-react";

const [announcementDocs, upcomingDocs, pastDocs] = await Promise.all([
  getAnnouncements(50),
  getUpcomingPrograms(30),
  getPastPrograms(12),
]);

const announcements = (announcementDocs ?? []).map(announcementToItem);
const upcoming = (upcomingDocs ?? []).map(eventToItem);
const past = (pastDocs ?? []).map(eventToItem);
const allItems = [...announcements, ...upcoming, ...past];

const ROW =
  "group flex items-center gap-4 rounded-2xl border border-border bg-card p-3 pr-4 transition-colors " +
  "hover:border-foreground/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring";
---

<BaseLayout pageTitle="News & events">
  <main class="layout-base gap-14 py-10">

    <header class="border-b border-border pb-6">
      <h1 class="mb-2 text-4xl text-foreground">News &amp; events</h1>
      <p class="max-w-2xl text-lg text-muted-foreground">
        Announcements and upcoming programs from Sajjadia Islamic Society. Select any item to see the full details and flyer.
      </p>
    </header>

    <!-- ── Announcements ── -->
    <section id="announcements" aria-labelledby="ann-title" class="scroll-mt-24">
      <h2 id="ann-title" class="mb-5 text-3xl text-foreground">Announcements</h2>

      {announcements.length > 0 ? (
        <ul class="grid gap-3 lg:grid-cols-2">
          {announcements.map((item) => (
            <li>
              <a href={item.path} data-detail-id={item.id} class={ROW}>
                {item.imageThumb ? (
                  <img src={item.imageThumb} alt="" width="80" height="80" loading="lazy" class="h-20 w-20 flex-none rounded-xl bg-muted object-cover" />
                ) : (
                  <span class="flex h-20 w-20 flex-none items-center justify-center rounded-xl bg-muted text-muted-foreground">
                    <Megaphone size={26} strokeWidth={1.5} aria-hidden="true" />
                  </span>
                )}
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-sm text-muted-foreground">
                    {item.category}
                    {item.isPinned && (
                      <span class="inline-flex items-center gap-1 font-semibold text-foreground">
                        <Pin size={13} aria-hidden="true" />
                        Pinned
                      </span>
                    )}
                  </span>
                  <span class="mt-0.5 block text-lg font-semibold leading-snug text-foreground underline-offset-2 group-hover:underline">
                    {item.title}
                  </span>
                  <span class="mt-0.5 block truncate text-[15px] text-muted-foreground">
                    {item.postedLabel ? `Posted ${item.postedLabel}` : item.summary}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="rounded-2xl border border-dashed border-border p-8 text-center text-muted-foreground">
          Nothing new right now. Join our WhatsApp group at the bottom of the page to hear about updates first.
        </p>
      )}
    </section>

    <!-- ── Upcoming events ── -->
    <section id="events" aria-labelledby="events-title" class="scroll-mt-24">
      <h2 id="events-title" class="mb-5 text-3xl text-foreground">Upcoming events</h2>

      {upcoming.length > 0 ? (
        <ul class="grid gap-3 lg:grid-cols-2">
          {upcoming.map((item) => (
            <li>
              <a href={item.path} data-detail-id={item.id} class={ROW}>
                <span class="flex h-20 w-20 flex-none flex-col items-center justify-center rounded-xl bg-muted" aria-hidden="true">
                  <span class="text-sm font-semibold text-muted-foreground">{item.shortDate?.dow}</span>
                  <span class="font-serif text-3xl leading-none text-foreground">{item.shortDate?.day}</span>
                  <span class="text-sm text-muted-foreground">{item.shortDate?.month}</span>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-sm text-muted-foreground">
                    {item.category}
                    {item.recurrence && (
                      <span class="inline-flex items-center gap-1">
                        <Repeat size={13} aria-hidden="true" />
                        Recurring
                      </span>
                    )}
                  </span>
                  <span class="mt-0.5 block text-lg font-semibold leading-snug text-foreground underline-offset-2 group-hover:underline">
                    {item.title}
                  </span>
                  <span class="mt-0.5 block truncate text-[15px] text-muted-foreground">
                    <span class="sr-only">{item.dateLabel}, </span>{item.summary}
                  </span>
                </span>
                {item.imageThumb && (
                  <img src={item.imageThumb} alt="" width="64" height="80" loading="lazy" class="hidden h-20 w-16 flex-none rounded-lg bg-muted object-cover sm:block" />
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="rounded-2xl border border-dashed border-border p-8 text-center text-muted-foreground">
          No upcoming events are scheduled yet. Weekly programs continue as usual; join our WhatsApp group for venue updates.
        </p>
      )}
    </section>

    <!-- ── Past events ── -->
    {past.length > 0 && (
      <section aria-labelledby="past-title">
        <h2 id="past-title" class="mb-5 text-2xl text-muted-foreground">Past events</h2>
        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {past.map((item) => (
            <li>
              <a href={item.path} data-detail-id={item.id} class={ROW}>
                {item.imageThumb ? (
                  <img src={item.imageThumb} alt="" width="56" height="56" loading="lazy" class="h-14 w-14 flex-none rounded-lg bg-muted object-cover" />
                ) : (
                  <span class="flex h-14 w-14 flex-none flex-col items-center justify-center rounded-lg bg-muted" aria-hidden="true">
                    <span class="font-serif text-xl leading-none text-foreground">{item.shortDate?.day}</span>
                    <span class="text-xs text-muted-foreground">{item.shortDate?.month}</span>
                  </span>
                )}
                <span class="min-w-0 flex-1">
                  <span class="block font-semibold leading-snug text-foreground underline-offset-2 group-hover:underline">{item.title}</span>
                  <span class="block truncate text-sm text-muted-foreground">{item.dateLabel}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <DetailDialog items={allItems} client:load />
  </main>
</BaseLayout>
