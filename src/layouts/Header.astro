---
import NavMenu from "@/components/NavMenu";
import Sidebar from "@/components/Sidebar";
import StyledText from "@/components/StyledText";
import { Image } from "astro:assets";
import { type ImageMetadata } from "astro";
import { siteConfig } from "@/data/contentCollectionDataFetching";
import { getSiteSettings } from "@/data/sanityQueries";
import logoNavy from "@/assets/logo-mono-navy.png";
import logoWhite from "@/assets/logo-mono-white.png";

const sanitySettings = await getSiteSettings();

const logoImage = import.meta.glob<{ default: ImageMetadata }>(`src/assets/*`);

const currentPath = Astro.url.pathname;
---

<header class="layout-full py-4 h-26 bg-card text-foreground border-b border-border">
  <div class="flex w-full items-center">
    <a href="/" aria-label="Sajjadia Islamic Society home" class="flex-none">
      <Image src={logoNavy} alt="" class="h-11 w-auto dark:hidden" />
      <Image src={logoWhite} alt="" class="hidden h-11 w-auto dark:block" />
    </a>
    &nbsp;&nbsp;
    {
      sanitySettings?.displayTitle ?? true ? (
        <StyledText as="h2" variant="displayLG" className="flex-1">
          <a href="/">{sanitySettings?.name ?? "Sajjadia Islamic Society"}</a>
        </StyledText>
      ) : (
        <h2 class="sr-only">{sanitySettings?.name ?? "Sajjadia Islamic Society"}</h2>
      )
    }

    <!-- Modern Animated Toggle Button -->
    <button
      id="theme-toggle"
      aria-label="Toggle light/dark mode"
      class="relative inline-flex h-11 w-11 items-center justify-center rounded-lg transition-colors text-muted-foreground hover:text-foreground hover:bg-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-ring"
    >
      <!-- Sun Icon (Rotates and scales up in Dark Mode) -->
      <svg
        class="h-6 w-6 rotate-90 scale-0 transition-all duration-300 dark:rotate-0 dark:scale-100"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m12.728 0l-.707-.707M6.343 6.343l-.707-.707m2.828 5.657a4 4 0 118 0 4 4 0 01-8 0z" />
      </svg>
      
      <!-- Moon Icon (Rotates and drops scale in Dark Mode) -->
      <svg
        class="absolute h-6 w-6 rotate-0 scale-100 transition-all duration-300 dark:-rotate-90 dark:scale-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
      </svg>
    </button>
    &nbsp;
    <NavMenu className="hidden gap-2 lg:inline-flex items-center flex-wrap" currentPath={currentPath} />

    <Sidebar currentPath={currentPath} client:load />
  </div>

  <script>
    function initThemeToggle() {
      const toggle = document.getElementById('theme-toggle');
      
      toggle?.addEventListener('click', () => {
        // Toggle class on document root element
        const isDark = document.documentElement.classList.toggle('dark');
        // Persist the preference to local storage
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
      });
    }

    // Initialize logic on current script load
    initThemeToggle();

    // Ensures functionality doesn't break if you use Astro ViewTransitions later
    document.addEventListener('astro:page-load', initThemeToggle);
  </script>
</header>