---
import { Font } from "astro:assets";

import "@/styles/global.css";
import "@/styles/theme.css";

import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import ContactModal from "@/components/ContactModal.astro";
import { siteConfig } from "@/data/contentCollectionDataFetching";
import { getSiteSettings } from "@/data/sanityQueries";

interface Props {
  pageTitle: string;
  description?: string;
  ogImage?: string;
}

const { pageTitle, description, ogImage: ogImageProp } = Astro.props;

const sanitySettings = await getSiteSettings();
const siteName = sanitySettings?.name ?? "Sajjadia Islamic Society";
const colorScheme = siteConfig?.data.theme?.colorScheme ?? "auto";
const metaTitle = pageTitle ? `${pageTitle} | ${siteName}` : siteName;
const metaDescription =
  description ??
  sanitySettings?.shortDescription ??
  "A Shia Muslim community organization serving Corona and Inland Empire, CA.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = ogImageProp ?? new URL("/og-image.jpg", Astro.site).toString();
---

<script is:inline define:vars={{ colorScheme }}>
  const getThemePreference = () => {
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light";
  };

  const isDark =
    colorScheme === "dark" ||
    (colorScheme === "auto" && getThemePreference() === "dark");
  document.documentElement.classList[isDark ? "add" : "remove"]("dark");
</script>

<html lang="en">
  <head>
    <!-- META -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- FAVICON -->
    <link rel="icon" type="image/png" href={"/sajjadia-logo.png"} />
    <link rel="apple-touch-icon" href={"/sajjadia-logo.png"} />

    <!-- TITLE -->
    <title>{metaTitle}</title>

    <!-- FONTS -->
    <Font cssVariable="--font-source-sans" preload />
    <Font cssVariable="--font-marcellus" preload />

    <!-- CRITICAL CSS (ABOVE-THE-FOLD) -->
    <style>
      body {
        margin: 0;
      }
      main,
      .hero {
        min-height: calc(100vh - 6.5rem);
      }
    </style>

    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
    
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList.toggle('dark', isDark);
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <ContactModal />
    <Footer />
  </body>
</html>
