---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro"
import { Font } from "astro:assets";

import "@/styles/global.css";

import Header from "@/layouts/Header.astro";
import Footer from "@/layouts/Footer.astro";
import ContactModal from "@/components/ContactModal.astro";
import { getSiteSettings } from "@/data/sanityQueries";

interface Props {
  pageTitle: string;
  description?: string;
  ogImage?: string;
}

const { pageTitle, description, ogImage: ogImageProp } = Astro.props;

const sanitySettings = await getSiteSettings();
const siteName = sanitySettings?.name ?? "Sajjadia Islamic Society";
const metaTitle = pageTitle ? `${pageTitle} | ${siteName}` : siteName;
const metaDescription =
  description ??
  sanitySettings?.shortDescription ??
  "A Shia Muslim community organization serving Corona and Inland Empire, CA.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImage = ogImageProp ?? new URL("/og-image.jpg", Astro.site).toString();
---

<html lang="en">
  <head>
    <!-- META -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={metaTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- FAVICON -->
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- INSTALLABLE APP (home screen icon, name, colors) -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#17203A" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Sajjadia" />

    <!-- TITLE -->
    <title>{metaTitle}</title>

    <!-- FONTS -->
    <Font cssVariable="--font-source-sans" preload />
    <Font cssVariable="--font-marcellus" preload />

    <!-- CRITICAL CSS (ABOVE-THE-FOLD) -->
    <style>
      body {
        margin: 0;
      }
      main,
      .hero {
        min-height: calc(100vh - 6.5rem);
      }
    </style>

    <script is:inline>
      const getThemePreference = () => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };
    
      const isDark = getThemePreference() === 'dark';
      document.documentElement.classList.toggle('dark', isDark);
    </script>
  </head>
  <body>
    <!-- Lets keyboard and screen reader users jump past the menu -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-background focus:px-4 focus:py-2 focus:font-semibold focus:text-foreground focus:shadow-lg focus:ring-2 focus:ring-ring"
    >
      Skip to content
    </a>
    <Header />
    <!-- The one main landmark for every page. Pages don't add their own. -->
    <main id="main-content" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <ContactModal />
    <Footer />
    <Analytics />
    <SpeedInsights/>
    <!-- Service worker: offline fallback for the installed app (live site only) -->
    <script>
      if (import.meta.env.PROD && "serviceWorker" in navigator) {
        navigator.serviceWorker.register("/sw.js").catch(() => {
          // Not critical: the site works the same without it
        });
      }
    </script>
  </body>
</html>
